{#- Tabliczka rysunkowa pod tytułem notatki (motyw „Arkusz”, styles/user/arkusz.scss).
    Autor, daty z `created` / `updated` i stan notatki z jej właściwości (`status`).
    „Zmieniono” pojawia się dopiero, gdy notatka ma późniejszą wersję niż pierwsza.
    Zastępuje wtyczkę dg-timestamps, wyłączoną w src/plugins/plugins.json. -#}
{%- macro dataPL(wartosc) -%}
  {%- set s = wartosc | string -%}
  {%- if r/^\d{4}-\d{2}-\d{2}/.test(s) -%}{{ s.slice(8, 10) }}.{{ s.slice(5, 7) }}.{{ s.slice(0, 4) }}{%- else -%}{{ s }}{%- endif -%}
{%- endmacro -%}
{%- set utworzono = (created | string).slice(0, 10) if created else "" -%}
{%- set zmieniono = (updated | string).slice(0, 10) if updated else "" -%}
{%- set stan = noteProps.status if noteProps and noteProps.status else "" -%}
{%- set etap = { "szkic": 1, "kiełek": 2, "dojrzała": 3 }[stan] -%}
{%- if utworzono or stan -%}
<dl class="tabliczka">
  <div class="pole"><dt>Autor</dt><dd>Sebastian Antolik</dd></div>
  {%- if utworzono %}
  <div class="pole"><dt>Utworzono</dt><dd><time datetime="{{ utworzono }}">{{ dataPL(created) }}</time></dd></div>
  {%- endif %}
  {%- if zmieniono and zmieniono != utworzono %}
  <div class="pole"><dt>Zmieniono</dt><dd><time datetime="{{ zmieniono }}">{{ dataPL(updated) }}</time></dd></div>
  {%- endif %}
  {%- if stan %}
  <div class="pole"><dt>Stan</dt><dd>{{ stan }}{% if etap %}<span class="etapy" title="etap {{ etap }} z 3: szkic, kiełek, dojrzała" aria-hidden="true">{% for i in range(1, 4) %}<i{% if i <= etap %} class="pelny"{% endif %}></i>{% endfor %}</span>{% endif %}</dd></div>
  {%- endif %}
</dl>
{%- endif -%}
